{
    "default": {
        "path": [
            "features/*.feature"
        ],
        "require": [
            "features/step_definitions/*.ts",
            "features/hooks/*.ts",
            "utils/getData.ts"
        ],
        "requireModule": [
            "ts-node/register"
        ],
        "format": [
            "json:reports/cucumber_report.json",
            "html:reports/cucumber_report.html",
            "pretty",
            "summary",
            "progress"
        ],
        "formatOptions": {
            "colorsEnabled": false,
            "forceColor": true
        },
        "timeout": 300000,
        "stepTimeout": 300000,
        "hookTimeout": 300000,
        "scenarioTimeout": 300000
    }
}
